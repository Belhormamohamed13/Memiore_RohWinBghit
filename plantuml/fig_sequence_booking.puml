@startuml fig_sequence_booking
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam shadowing false
skinparam SequenceMessageAlignment center

skinparam sequence {
  ArrowColor #A83B3B
  ActorBorderColor #1565C0
  ActorBackgroundColor #BBDEFB
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #FFF9C4
  ParticipantBorderColor #4B3A8B
  ParticipantBackgroundColor #D1C4E9
  ParticipantFontStyle bold
}

title Diagramme de séquence système — Réservation et paiement

actor "Passager" as P
participant ":Système" as S
actor "Conducteur" as C #C8E6C9

P -> S : 1: Choisir un trajet et cliquer sur "Réserver"
activate S
S --> P : 2: Demander le choix du mode de paiement (carte ou espèces)
deactivate S

P -> S : 3: Sélectionner le mode de paiement et valider
activate S
S -> S : 4: Calculer le prix final (avec tarification dynamique)
S -> S : 5: Effectuer la transaction sécurisée (séquestre des fonds)

alt Paiement accepté
  S --> P : 6: Confirmer la réservation (en attente de validation)
  S --> C : 7: Envoyer une notification de nouvelle réservation
  deactivate S
  
  C -> S : 8: Accepter la demande de réservation
  activate S
  S -> S : 9: Mettre à jour le statut et déduire les places disponibles
  S --> P : 10: Envoyer la notification de confirmation finale avec QR code
  S --> C : 11: Confirmer la validation de la réservation
else Paiement refusé
  S --> P : 12: Afficher un message d'erreur de paiement et annuler la réservation
end
deactivate S

@enduml
