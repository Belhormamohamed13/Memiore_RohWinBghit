@startuml fig_sequence_kyc
!include theme_rohwinbghit.puml
skinparam style strictuml
skinparam SequenceMessageAlignment center

title Séquence — Vérification d'Identité (KYC) Biométrique Multi-Étapes

actor "Utilisateur" as U
participant "App Mobile\n(React Native)" as App
participant "Backend API\n(Express.js)" as API
database "PostgreSQL\n(Base de Données)" as DB
participant "Service IA\n(FastAPI)" as AI
participant "Service Notification\n(Expo FCM)" as Notif
actor "Administrateur" as Admin

== Phase 1 : Démarrage et Upload de la Carte d'Identité (CIN) ==

U -> App : Saisir et capturer CIN recto/verso
App -> API : POST /api/verification/upload-cin\n{ cin_recto, cin_verso, document_type, OCR_data }
activate API

API -> DB : Créer/Mettre à jour la session de vérification (status = 'pending')
API -> API : Chiffrer les fichiers à l'état de repos (AES-256-GCM)

API -> AI : [Asynchrone] Extraire embedding photo CIN (POST /extract-face)
activate AI
AI --> API : Embedding facial (Float32Array)
deactivate AI
API -> DB : Sauvegarder l'embedding dans la table face_embeddings

API -> AI : [Asynchrone] Contrôler l'authenticité de la pièce (POST /check-document)
activate AI
AI --> API : Score de détection de réaffichage (screen_score)
deactivate AI
API -> DB : Mettre à jour doc_screen_score et doc_screen_warning (si score >= 0.65)

API --> App : Retourner succès (CIN enregistrée, prêt pour le selfie)
deactivate API

== Phase 2 : Capture du Selfie et Vérification Biométrique ==

U -> App : Effectuer la capture du selfie (détection de vie)
App -> API : POST /api/verification/upload-face\n{ selfie }
activate API

API -> AI : Comparer CIN vs Selfie (POST /verify-face)
activate AI
AI --> API : { faceMatchScore, rawSimilarity, isLive, livenessScore }
deactivate AI

alt Similarté critique (rawSimilarity < 0.25) [Tentative d'Imposture]
  API -> API : Supprimer le fichier selfie
  API -> DB : Mettre à jour verification (status = 'rejected', reason)
  API -> DB : Enregistrer un signalement de fraude (fraud_events)
  API -> DB : Mettre à jour l'utilisateur (identity_status = 'rejected')
  API --> App : Retourner Erreur 422 : Visage ne correspond pas
  App --> U : Afficher message de rejet de sécurité
  
  API -> Notif : Envoyer alerte de fraude aux administrateurs (Expo FCM)
  activate Notif
  Notif --> Admin : Push notification : Tentative de fraude KYC détectée ! ⚠️
  deactivate Notif

else Échec détection de vie (isLive === false) [Rejeu / Photo papier]
  API -> API : Supprimer le fichier selfie
  API --> App : Retourner Erreur 422 : Échec du contrôle de vivacité
  App --> U : Demander de reprendre la photo (éclairage, mouvement)

else Biométrie valide / Ambiguë (rawSimilarity >= 0.25 && isLive === true)
  API -> API : Chiffrer le fichier selfie (AES-256-GCM)
  API -> DB : Mettre à jour identity_verifications (scores, selfie_url)
  
  API -> AI : [Asynchrone] Extraire et stocker embedding selfie (POST /check-liveness)
  activate AI
  AI --> API : Embedding facial selfie
  deactivate AI
  API -> DB : Enregistrer embedding selfie dans face_embeddings
  
  alt Score global >= Seuil d'Approbation (0.80 Conducteur / 0.70 Passager)
    API -> DB : Mettre à jour verification (status = 'verified')
    API -> DB : Mettre à jour l'utilisateur (identity_status = 'verified')
    API -> Notif : Envoyer notification de succès
    activate Notif
    Notif --> U : Push notification : Votre identité est vérifiée ✅
    deactivate Notif
  else Score global >= Seuil de Revue Manuelle (0.60)
    API -> DB : Mettre à jour verification (status = 'pending_review')
    API -> DB : Mettre à jour l'utilisateur (identity_status = 'pending')
    API -> Notif : Envoyer notification de mise en attente
    activate Notif
    Notif --> U : Push notification : KYC en cours d'examen manuel (24h)
    deactivate Notif
  else Score global < 0.60
    API -> DB : Mettre à jour verification (status = 'rejected')
    API -> DB : Enregistrer l'événement de fraude de sévérité moyenne
    API -> DB : Mettre à jour l'utilisateur (identity_status = 'rejected')
    API -> Notif : Envoyer notification d'échec
    activate Notif
    Notif --> U : Push notification : Échec de la vérification d'identité ❌
    deactivate Notif
  end
  API --> App : Retourner succès (Statut actuel de la vérification)
end
deactivate API

== Phase 3 : Revue Manuelle par l'Administrateur (Si statut 'pending_review') ==

Admin -> App : Consulter la file d'attente (GET /api/verification/admin/queue)
App -> API : Demander la liste des dossiers
API -> DB : Récupérer les dossiers 'pending_review'
DB --> API : Dossiers + scores IA + avertissements écran
API --> App : Afficher la file
App --> Admin : Présenter la comparaison côte à côte

alt Validation manuelle
  Admin -> App : Approuver le dossier
  App -> API : POST /api/verification/admin/:id/approve
  activate API
  API -> DB : Mettre à jour verification (status='verified') & user (identity_status='verified')
  API -> Notif : Déclencher notification succès
  Notif --> U : Push notification : Identité approuvée manuellement ! ✅
  API --> App : Renvoyer succès
  deactivate API
else Rejet manuel
  Admin -> App : Rejeter le dossier
  App -> API : POST /api/verification/admin/:id/reject\n{ reason }
  activate API
  API -> DB : Mettre à jour verification (status='rejected') & user (identity_status='rejected')
  API -> Notif : Déclencher notification rejet
  Notif --> U : Push notification : Identité rejetée : [motif] ❌
  API --> App : Renvoyer succès
  deactivate API
end

@enduml
