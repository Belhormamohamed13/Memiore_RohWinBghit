@startuml fig_sequence_kyc
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam shadowing false
skinparam SequenceMessageAlignment center

skinparam sequence {
  ArrowColor #A83B3B
  ActorBorderColor #1565C0
  ActorBackgroundColor #BBDEFB
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #FFF9C4
  ParticipantBorderColor #4B3A8B
  ParticipantBackgroundColor #D1C4E9
  ParticipantFontStyle bold
}

title Diagramme de séquence système — Vérification d'identité (KYC)

actor "Utilisateur" as U
participant ":Système" as S
actor "Administrateur" as A #C8E6C9

U -> S : 1: Soumettre le scan de la carte d'identité (recto/verso)
activate S
S --> U : 2: Confirmer la réception et demander la vidéo de vivacité
deactivate S

U -> S : 3: Soumettre la capture vidéo de vivacité (3 secondes)
activate S
S --> U : 4: Afficher le statut temporaire (En cours de traitement)

alt Cas 1 : Validation automatique (scores élevés)
  S --> U : 5: Notifier la validation de l'identité (compte vérifié)
else Cas 2 : Rejet automatique (fraude détectée / scores critiques)
  S --> U : 6: Notifier le rejet de l'identité et enregistrer l'alerte
else Cas 3 : Revue manuelle requise (scores intermédiaires)
  S -> S : 7: Placer le dossier en file d'attente de modération
  A -> S : 8: Consulter la file d'attente des dossiers en attente
  A -> S : 9: Valider ou rejeter le dossier manuellement
  S --> U : 10: Notifier la décision finale à l'utilisateur
end
deactivate S

@enduml
