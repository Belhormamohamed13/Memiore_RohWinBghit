@startuml fig_sequence_inscription
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam shadowing false
skinparam SequenceMessageAlignment center

skinparam sequence {
  ArrowColor #A83B3B
  ActorBorderColor #1565C0
  ActorBackgroundColor #BBDEFB
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #FFF9C4
  ParticipantBorderColor #4B3A8B
  ParticipantBackgroundColor #D1C4E9
  ParticipantFontStyle bold
  DatabaseBorderColor #F9A825
  DatabaseBackgroundColor #FFF9C4
}

title Diagramme de séquence — Inscription (RohWinBghit)

actor "r : Utilisateur" as U
participant "System" as S
database "BDD" as DB

U -> S : Affichage de l'écran d'accueil
U -> S : Demander à s'inscrire

alt Rôle de l'utilisateur (Conducteur / Passager)

  alt Téléphone & code de validation corrects
    U -> S : Saisir le numéro de téléphone
    S -> DB : Vérifier la disponibilité du numéro
    DB --> S : Numéro disponible
    S --> U : Envoi du code de validation par SMS
    U -> S : Saisir le code de validation reçu
    S -> S : Vérifier le code de validation
    S --> U : Code de validation validé
    U -> S : Saisir les informations de profil\n(Nom, Prénom, Email, Mot de passe)
    S -> DB : Enregistrer les données de l'utilisateur
    DB --> S : Utilisateur créé
    S --> U : Inscription réussie\n(Rôle attribué : passager ou conducteur)
  else Code de validation invalide ou expiré
    U -> S : Saisir un code de validation incorrect
    S -> S : Vérifier le code de validation
    S --> U : Message : Code de validation invalide ou expiré
  end

end

@enduml
