@startuml fig_sequence_trip_request
skinparam style strictuml
skinparam DefaultFontName Arial
skinparam DefaultFontSize 12
skinparam shadowing false
skinparam SequenceMessageAlignment center

skinparam sequence {
  ArrowColor #A83B3B
  ActorBorderColor #1565C0
  ActorBackgroundColor #BBDEFB
  LifeLineBorderColor #1565C0
  LifeLineBackgroundColor #FFF9C4
  ParticipantBorderColor #4B3A8B
  ParticipantBackgroundColor #D1C4E9
  ParticipantFontStyle bold
}

title Diagramme de séquence système — Demande de trajet et matching

actor "Passager" as P
participant ":Système" as S
actor "Conducteur" as C #C8E6C9

P -> S : 1: Saisir les détails de la demande (départ, destination, date, places)
activate S
S --> P : 2: Valider et confirmer la publication de la demande
deactivate S

S -> S : 3: Rechercher les conducteurs éligibles (matching)
activate S
S --> C : 4: Envoyer une notification de demande disponible
deactivate S

C -> S : 5: Consulter les détails de la demande de trajet
activate S
S --> C : 6: Afficher les informations détaillées
deactivate S

C -> S : 7: Cliquer sur "Proposer un trajet"
activate S
S -> S : 8: Associer le conducteur à la demande et fermer la demande
S --> P : 9: Notifier le passager qu'un conducteur a accepté sa demande
S --> C : 10: Confirmer la création du trajet
deactivate S

@enduml
